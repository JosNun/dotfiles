#!/bin/bash
# run_once_install-packages.sh.tmpl
# This script automatically installs essential development packages
# It's run once by chezmoi during initial setup
# The script detects the package manager and handles distro-specific package names

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Symbols for output
CHECK_MARK="${GREEN}✓${NC}"
CROSS_MARK="${RED}✗${NC}"
INFO_MARK="${BLUE}ℹ${NC}"
WARN_MARK="${YELLOW}⚠${NC}"

echo -e "${BLUE}=== Installing Essential Development Packages ===${NC}\n"

# Package list from chezmoi data
PACKAGES=(
{{- range .packages.essential }}
    {{ . | quote }}
{{- end }}
)

# Track failed installations
FAILED_PACKAGES=()
SKIPPED_PACKAGES=()

# Function to detect package manager
detect_package_manager() {
    if command -v brew &> /dev/null; then
        echo "brew"
    elif command -v apt-get &> /dev/null; then
        echo "apt"
    elif command -v pacman &> /dev/null; then
        echo "pacman"
    elif command -v dnf &> /dev/null; then
        echo "dnf"
    elif command -v apk &> /dev/null; then
        echo "apk"
    else
        echo "unknown"
    fi
}

# Function to check if a package/command is already installed
is_installed() {
    local pkg=$1

    # Check if the command exists in PATH
    # Handle special cases where package name != command name
    case $pkg in
        neovim)
            command -v nvim &> /dev/null
            ;;
        bat)
            command -v bat &> /dev/null || command -v batcat &> /dev/null
            ;;
        ripgrep)
            command -v rg &> /dev/null
            ;;
        git-delta)
            command -v delta &> /dev/null
            ;;
        *)
            command -v "$pkg" &> /dev/null
            ;;
    esac
}

# Function to get the package name for the current package manager
get_package_name() {
    local pkg=$1
    local pm=$2

    # Map package names based on package manager
    case $pm in
        apt)
            case $pkg in
                lazygit) echo "" ;;  # Special handling required
                starship) echo "" ;;  # Special handling required
                git-delta) echo "" ;;  # Special handling required
                *) echo "$pkg" ;;
            esac
            ;;
        dnf)
            case $pkg in
                lazygit) echo "" ;;  # Special handling required
                *) echo "$pkg" ;;
            esac
            ;;
        apk)
            case $pkg in
                starship) echo "" ;;  # Special handling required
                git-delta) echo "" ;;  # Special handling required
                *) echo "$pkg" ;;
            esac
            ;;
        *)
            echo "$pkg"
            ;;
    esac
}

# Function to install a package
install_package() {
    local pkg=$1
    local pm=$2
    local pkg_name

    pkg_name=$(get_package_name "$pkg" "$pm")

    # Skip if package name is empty (special handling required)
    if [[ -z "$pkg_name" ]]; then
        return 1
    fi

    case $pm in
        brew)
            brew install "$pkg_name" 2>&1 | grep -v "Warning:" || return 1
            ;;
        apt)
            sudo apt-get install -y "$pkg_name" &> /dev/null || return 1
            ;;
        pacman)
            sudo pacman -S --noconfirm "$pkg_name" &> /dev/null || return 1
            ;;
        dnf)
            sudo dnf install -y "$pkg_name" &> /dev/null || return 1
            ;;
        apk)
            sudo apk add "$pkg_name" &> /dev/null || return 1
            ;;
        *)
            return 1
            ;;
    esac
}

# Special installation functions for packages not in standard repos
install_lazygit_special() {
    local pm=$1

    case $pm in
        apt|dnf)
            # Install lazygit from GitHub releases
            echo -e "${INFO_MARK} Installing lazygit from GitHub releases..."
            LAZYGIT_VERSION=$(curl -sL "https://api.github.com/repos/jesseduffield/lazygit/releases/latest" | grep '"tag_name"' | sed -E 's/.*"tag_name": "v([^"]+)".*/\1/')
            curl -sSLo lazygit.tar.gz "https://github.com/jesseduffield/lazygit/releases/latest/download/lazygit_${LAZYGIT_VERSION}_Linux_x86_64.tar.gz" &> /dev/null
            tar xf lazygit.tar.gz lazygit &> /dev/null
            sudo install lazygit /usr/local/bin &> /dev/null
            rm lazygit lazygit.tar.gz
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

install_starship_special() {
    local pm=$1

    case $pm in
        dnf)
            # Enable COPR repository for starship on Fedora
            sudo dnf copr enable -y atim/starship &> /dev/null || return 1
            sudo dnf install -y starship &> /dev/null || return 1
            return 0
            ;;
        apt|apk)
            # Install starship using official installer script
            curl -sS https://starship.rs/install.sh | sh -s -- -y &> /dev/null || return 1
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

install_git_delta_special() {
    local pm=$1

    case $pm in
        apt|apk)
            # Install git-delta from GitHub releases
            DELTA_VERSION=$(curl -sL "https://api.github.com/repos/dandavison/delta/releases/latest" | grep '"tag_name"' | sed -E 's/.*"tag_name": "([^"]+)".*/\1/')
            if [[ -z "$DELTA_VERSION" ]]; then
                return 1
            fi

            # Determine architecture and OS
            local arch=$(uname -m)
            local os_type="unknown-linux-gnu"
            if [[ "$pm" == "apk" ]]; then
                os_type="alpine-linux-musl"
            fi

            case $arch in
                x86_64) arch="x86_64" ;;
                aarch64) arch="aarch64" ;;
                armv7l) arch="armv7" ;;
                *) return 1 ;;
            esac

            # Download and install
            local download_url="https://github.com/dandavison/delta/releases/download/${DELTA_VERSION}/delta-${DELTA_VERSION}-${arch}-${os_type}.tar.gz"
            if ! curl -sSL -o delta.tar.gz "$download_url"; then
                return 1
            fi

            if ! tar xf delta.tar.gz 2>/dev/null; then
                rm -f delta.tar.gz
                return 1
            fi

            if ! sudo install delta-${DELTA_VERSION}-${arch}-${os_type}/delta /usr/local/bin 2>/dev/null; then
                rm -rf delta.tar.gz delta-${DELTA_VERSION}-${arch}-${os_type}
                return 1
            fi

            rm -rf delta.tar.gz delta-${DELTA_VERSION}-${arch}-${os_type}
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# Main installation logic
main() {
    # Detect package manager
    PKG_MANAGER=$(detect_package_manager)

    if [[ "$PKG_MANAGER" == "unknown" ]]; then
        echo -e "${CROSS_MARK} Could not detect a supported package manager"
        echo -e "  Supported: brew, apt, pacman, dnf, apk"
        exit 1
    fi

    echo -e "${INFO_MARK} Detected package manager: ${BLUE}$PKG_MANAGER${NC}\n"

    # Update package manager cache
    echo -e "${INFO_MARK} Updating package manager cache..."
    case $PKG_MANAGER in
        apt)
            sudo apt-get update &> /dev/null
            ;;
        pacman)
            sudo pacman -Sy &> /dev/null
            ;;
        dnf)
            sudo dnf check-update &> /dev/null || true
            ;;
        apk)
            sudo apk update &> /dev/null
            ;;
    esac
    echo -e "${CHECK_MARK} Package cache updated\n"

    # Install each package
    for pkg in "${PACKAGES[@]}"; do
        echo -n "Installing $pkg... "

        # Check if already installed
        if is_installed "$pkg"; then
            echo -e "${YELLOW}already installed${NC}"
            continue
        fi

        # Try standard installation
        if install_package "$pkg" "$PKG_MANAGER"; then
            echo -e "${CHECK_MARK}"
            continue
        fi

        # Try special installation methods
        if [[ "$pkg" == "lazygit" ]] && install_lazygit_special "$PKG_MANAGER"; then
            echo -e "${CHECK_MARK} (from GitHub)"
            continue
        fi

        if [[ "$pkg" == "starship" ]] && install_starship_special "$PKG_MANAGER"; then
            case $PKG_MANAGER in
                dnf) echo -e "${CHECK_MARK} (from COPR)" ;;
                *) echo -e "${CHECK_MARK} (from starship.rs)" ;;
            esac
            continue
        fi

        if [[ "$pkg" == "git-delta" ]] && install_git_delta_special "$PKG_MANAGER"; then
            echo -e "${CHECK_MARK} (from GitHub)"
            continue
        fi

        # If we get here, installation failed
        echo -e "${CROSS_MARK}"
        FAILED_PACKAGES+=("$pkg")
    done

    # Summary
    echo -e "\n${BLUE}=== Installation Summary ===${NC}"

    if [[ ${#FAILED_PACKAGES[@]} -eq 0 ]]; then
        echo -e "${CHECK_MARK} All packages installed successfully!"
    else
        echo -e "${WARN_MARK} Some packages could not be installed:\n"
        for pkg in "${FAILED_PACKAGES[@]}"; do
            echo -e "  ${CROSS_MARK} $pkg"
        done
        echo -e "\n${INFO_MARK} You may need to install these packages manually."
    fi
}

main
